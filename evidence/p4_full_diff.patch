+    o0, s0 = _pending_counts(db)
+    # 待建(7自然日窗口):S1,S2,S3,S5,S6,S8(S4 在窗口外,S7 已成交)
+    # 待审批(60日,ap 为空且 f.date=s.date 无成交):S1..S7
