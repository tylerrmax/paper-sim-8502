+            "forward_immature": sum(
+                1 for s in fwd if s["maturity_status"] == "immature"),
+            "forward_missing": sum(
+                1 for s in fwd if s["maturity_status"] == "missing"),
+            "backfill_count": len(bf),
+            "forward_null_metric_sample_ids": null_metric_ids,
+        }
