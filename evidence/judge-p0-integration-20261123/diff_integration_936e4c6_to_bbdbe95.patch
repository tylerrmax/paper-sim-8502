+# -*- coding: utf-8 -*-
+"""P0-1 集成对抗测试（2026-11-23，judge-p0-integration）：规则版本绑定。
+
+审计口径：实现对象声明版本必须与注册版本完全一致；禁止显式
+version 参数覆盖实际实现版本；不匹配时拒绝判定
+（not_evaluable）。本文件在 fix3 基线（已含 P0-B 精确绑定）
+上以审计给定的对抗形态逐项验证：
+
+- v1 实现经显式 version='v2' 冒充登记 -> judge v2 拒绝
+  （IMPL_MISMATCH：登记条目的 impl_version 恒取实现自报
+  版本，显式参数改不了 impl_version）；
+- 注册表为 v2 伪造 impl_version='v1' 绑定 -> judge v2 拒绝
+  （NO_IMPL：实现只按 (rule_id, version) 精确取）；
+- 只有 v2 实现时 judge v1 -> NO_IMPL 拒绝；
+- 正对照：版本精确一致时判定可通过。
+"""
+from datetime import date, timedelta
+
+import pytest
+
+from market_first import validation
+from market_first.models import DiscoveryEvent
+from market_first.pool import CandidatePool
+from market_first.promotion import transition
+
+RID = "p01_bind_rule"
+
+
+class _Rule:
+    def __init__(self, version):
+        self.version = version
+
+    def evaluate(self, scope, metrics):
+        return "passed", "p0-1 test rule %s" % self.version
+
+
+def _bars(start=date(2026, 11, 13), end=date(2026, 12, 20)):
+    out = []
+    d = start
+    i = 0
+    while d <= end:
+        if d.weekday() < 5:
+            c = 10.0 + 0.1 * i
+            out.append((d.isoformat(), c, c, c, c, 1000.0))
+            i += 1
+        d += timedelta(days=1)
+    return out
+
+
+def _candidate_validating(tmp_path):
+    pool = CandidatePool(db_path=str(tmp_path / "mf.db"))
+    ev = DiscoveryEvent(
+        market="SZ", symbol="002623", name="亚玛顿",
+        source_id="inst_lhb_live",
+        discovered_at="2026-11-13T16:30:00+08:00",
+        trigger_condition="inst_net>0", evidence={"inst_net": 100.0})
+    cid, _ = pool.ingest(ev)
+    pool.conn.execute(
+        "UPDATE discovery_events SET created_at=?"
+        " WHERE candidate_id=?", (ev.discovered_at, cid))
+    pool.conn.commit()
+    for state in ("pending_research", "researching", "validating"):
+        transition(pool, cid, state, actor="tester")
+    return pool, cid
+
+
+def _mature_forward(pool, cid):
+    ev = pool.events_for(cid)[0]
+    bars = _bars()
+    sid = validation.create_sample(
+        pool, cid, ev["source_id"], kind="forward",
+        discovery_event_id=ev["id"], bars=bars)
+    validation.evaluate_sample(pool, sid, bars)
+    return sid
+
+
+@pytest.fixture(autouse=True)
+def _clean_impls():
+    yield
+    for key in [k for k in validation.RULE_IMPLEMENTATIONS
+                if k[0] == RID]:
+        validation.RULE_IMPLEMENTATIONS.pop(key, None)
+
+
+def _register_approved(pool, version, **kw):
+    kw.setdefault("approved_by", "unit-test")
+    kw.setdefault("actor", "unit-test")
+    kw.setdefault("reason", "p0-1 integration test registration")
+    kw.setdefault("approval_basis", "test-only approval (tmp db)")
+    return validation.register_rule(
+        pool, RID, version, status="approved", **kw)
+
+
+def test_v1_impl_cannot_impersonate_v2_via_explicit_version(tmp_path):
+    """v1 实现以显式 version='v2' 登记（冒充）：登记条目的
+    impl_version 恒为实现自报的 'v1'，judge v2 必须拒绝。"""
+    pool, cid = _candidate_validating(tmp_path)
+    _mature_forward(pool, cid)
+    validation.register_rule_implementation(RID, _Rule("v1"),
+                                            version="v2")
+    entry = validation.RULE_IMPLEMENTATIONS[(RID, "v2")]
+    # 显式 version 只改变登记键，覆盖不了实现自报版本
+    assert entry["impl_version"] == "v1"
+    _register_approved(pool, "v2")  # 注册表绑定 impl_version='v2'
+    out = validation.judge_validation(
+        pool, cid, rule_id=RID, rule_version="v2")
+    assert out["decision"] == "not_evaluable"
+    assert "IMPL_MISMATCH" in out["basis"]
+    assert pool.get_by_id(cid)["promotion_status"] == "validating"
+
+
+def test_registry_forged_impl_version_binding_rejected(tmp_path):
+    """注册表为 v2 伪造 impl_version='v1' 绑定，代码侧只有
+    v1 实现：judge v2 按 (rule_id, 'v2') 精确取实现 -> 无
+    实现，拒绝判定，不得借 v1 实现冒充 v2。"""
+    pool, cid = _candidate_validating(tmp_path)
+    _mature_forward(pool, cid)
+    validation.register_rule_implementation(RID, _Rule("v1"))
+    _register_approved(pool, "v2", impl_version="v1")
+    out = validation.judge_validation(
+        pool, cid, rule_id=RID, rule_version="v2")
+    assert out["decision"] == "not_evaluable"
+    assert "NO_IMPL" in out["basis"]
+
+
+def test_v2_impl_does_not_satisfy_v1_judgement(tmp_path):
+    """只有 v2 实现时，judge v1 无精确版本实现 -> 拒绝。"""
+    pool, cid = _candidate_validating(tmp_path)
+    _mature_forward(pool, cid)
+    validation.register_rule_implementation(RID, _Rule("v2"))
+    _register_approved(pool, "v1")
+    out = validation.judge_validation(
+        pool, cid, rule_id=RID, rule_version="v1")
+    assert out["decision"] == "not_evaluable"
+    assert "NO_IMPL" in out["basis"]
+
+
+def test_exact_version_match_positive_control(tmp_path):
+    """正对照：实现自报版本与注册版本精确一致 -> 可判定。"""
+    pool, cid = _candidate_validating(tmp_path)
+    _mature_forward(pool, cid)
+    validation.register_rule_implementation(RID, _Rule("v2"))
+    _register_approved(pool, "v2")
+    out = validation.judge_validation(
+        pool, cid, rule_id=RID, rule_version="v2")
+    assert out["decision"] == "passed"
+    assert out["rule_id"] == RID
+    assert out["rule_version"] == "v2"
diff --git a/tests/test_market_first_p0_3_approval_info.py b/tests/test_market_first_p0_3_approval_info.py
new file mode 100644
index 0000000..850f0f7
--- /dev/null
+++ b/tests/test_market_first_p0_3_approval_info.py
@@ -0,0 +1,166 @@
+# -*- coding: utf-8 -*-
+"""P0-3 集成对抗测试（2026-11-23，judge-p0-integration）：批准信息强制。
+
+审计口径：rule 状态转为 approved 时必须具备明确 actor、
+reason、批准依据；同事务写入 approved_by、approved_at、
+approval_basis 与 registry_history 留痕；无批准信息时整个
+事务回滚（状态不变、无留痕、批准字段不落字）。
+
+对抗形态：
+- 无批准人（approved_by/actor 皆缺）-> 拒绝且回滚；
+- 无 reason -> 拒绝且回滚；
+- 无批准依据（approval_basis 缺失/空白）-> 拒绝且回滚；
+- 伪造批准信息：调用方回填 approved_at 为历史时刻 ->
+  落库值恒为服务器时间，伪造值不生效；
+- set_rule_status 转 approved 缺任一项 -> 拒绝且回滚；
+- 正对照：信息齐备 -> 状态、批准字段、留痕同事务落字；
+- registry_history append-only：UPDATE/DELETE 被触发器拒绝。
+"""
+import sqlite3
+from datetime import datetime
+
+import pytest
+
+from market_first import validation
+from market_first.pool import CandidatePool
+
+RID = "p03_rule"
+
+
+def _pool(tmp_path):
+    return CandidatePool(db_path=str(tmp_path / "mf.db"))
+
+
+def _hist(pool):
+    return validation.registry_history(pool, entity_type="rule",
+                                       entity_id=RID)
+
+
+def test_register_approved_requires_reason_and_basis(tmp_path):
+    pool = _pool(tmp_path)
+    with pytest.raises(ValueError):
+        validation.register_rule(
+            pool, RID, "v1", status="approved",
+            approved_by="unit-test")  # 无 reason / 无依据
+    with pytest.raises(ValueError):
+        validation.register_rule(
+            pool, RID, "v1", status="approved",
+            approved_by="unit-test", reason="r")  # 无依据
+    with pytest.raises(ValueError):
+        validation.register_rule(
+            pool, RID, "v1", status="approved",
+            approved_by="unit-test", reason="r",
+            approval_basis="   ")  # 依据为空白 = 无依据
+    # 全部回滚：注册表无行、留痕无行
+    assert validation.get_registered_rule(pool, RID, "v1") is None
+    assert _hist(pool) == []
+
+
+def test_register_approved_requires_approver(tmp_path):
+    pool = _pool(tmp_path)
+    with pytest.raises(ValueError):
+        validation.register_rule(
+            pool, RID, "v1", status="approved",
+            reason="r", approval_basis="b")  # 无批准人
+    assert validation.get_registered_rule(pool, RID, "v1") is None
+    assert _hist(pool) == []
+
+
+def test_register_approved_forged_approved_at_ignored(tmp_path):
+    """伪造批准信息：approved_at 回填为 2020 年 -> 落库恒为
+    服务器当前时间，伪造值不生效；actor/reason/依据与留痕
+    同事务落字。"""
+    pool = _pool(tmp_path)
+    before = datetime.now().astimezone()
+    validation.register_rule(
+        pool, RID, "v1", status="approved",
+        approved_by="unit-test", approved_at="2020-01-01T00:00:00+08:00",
+        actor="unit-test", reason="integration approval",
+        approval_basis="user ruling 2026-11-23 (test)")
+    row = validation.get_registered_rule(pool, RID, "v1")
+    assert row["status"] == "approved"
+    assert row["approved_by"] == "unit-test"
+    assert not row["approved_at"].startswith("2020-")
+    stored = datetime.fromisoformat(row["approved_at"])
+    assert stored >= before.replace(microsecond=0)
+    assert row["approval_basis"] == "user ruling 2026-11-23 (test)"
+    hist = _hist(pool)
+    assert len(hist) == 1
+    assert hist[0]["field"] == "status"
+    assert hist[0]["old_value"] is None
+    assert hist[0]["new_value"] == "approved"
+    assert hist[0]["actor"] == "unit-test"
+    assert hist[0]["reason"] == "integration approval"
+    assert hist[0]["basis"] == "user ruling 2026-11-23 (test)"
+
+
+def test_set_status_to_approved_requires_full_info_and_rolls_back(tmp_path):
+    pool = _pool(tmp_path)
+    validation.register_rule(pool, RID, "v1", status="draft")
+    base_hist = len(_hist(pool))
+    for kw in ({}, {"actor": "unit-test"},
+               {"actor": "unit-test", "reason": "r"},
+               {"actor": "unit-test", "reason": "r",
+                "approval_basis": "  "}):
+        with pytest.raises(ValueError):
+            validation.set_rule_status(pool, RID, "v1", "approved",
+                                       **kw)
+        row = validation.get_registered_rule(pool, RID, "v1")
+        assert row["status"] == "draft"          # 状态未变
+        assert row["approved_by"] is None        # 批准字段未落字
+        assert row["approved_at"] is None
+        assert len(_hist(pool)) == base_hist     # 无留痕
+
+
+def test_set_status_to_approved_writes_all_fields_atomically(tmp_path):
+    pool = _pool(tmp_path)
+    validation.register_rule(pool, RID, "v1", status="draft")
+    validation.set_rule_status(
+        pool, RID, "v1", "approved", actor="unit-test",
+        reason="promotion review passed",
+        approval_basis="audit verdict P0-3 (test)")
+    row = validation.get_registered_rule(pool, RID, "v1")
+    assert row["status"] == "approved"
+    assert row["approved_by"] == "unit-test"
+    assert row["approved_at"]
+    assert row["approval_basis"] == "audit verdict P0-3 (test)"
+    hist = _hist(pool)
+    last = hist[-1]
+    assert last["old_value"] == "draft"
+    assert last["new_value"] == "approved"
+    assert last["actor"] == "unit-test"
+    assert last["reason"] == "promotion review passed"
+    assert last["basis"] == "audit verdict P0-3 (test)"
+
+
+def test_non_approved_transitions_still_work_without_approval_info(tmp_path):
+    """非 approved 流转（如停用）不要求批准信息，保持既有
+    调用兼容；留痕仍写入（actor/reason 可缺省）。"""
+    pool = _pool(tmp_path)
+    validation.register_rule(
+        pool, RID, "v1", status="approved", approved_by="unit-test",
+        actor="unit-test", reason="r", approval_basis="b")
+    validation.set_rule_status(pool, RID, "v1", "disabled")
+    row = validation.get_registered_rule(pool, RID, "v1")
+    assert row["status"] == "disabled"
+    hist = _hist(pool)
+    assert hist[-1]["old_value"] == "approved"
+    assert hist[-1]["new_value"] == "disabled"
+
+
+def test_registry_history_is_append_only(tmp_path):
+    pool = _pool(tmp_path)
+    validation.register_rule(pool, RID, "v1", status="draft")
+    hist = _hist(pool)
+    assert len(hist) == 1
+    with pytest.raises(sqlite3.IntegrityError):
+        pool.conn.execute(
+            "UPDATE registry_history SET reason='tampered'"
+            " WHERE id=?", (hist[0]["id"],))
+    pool.conn.rollback()
+    with pytest.raises(sqlite3.IntegrityError):
+        pool.conn.execute(
+            "DELETE FROM registry_history WHERE id=?",
+            (hist[0]["id"],))
+    pool.conn.rollback()
+    assert len(_hist(pool)) == 1
diff --git a/tests/test_market_first_p0_5_time_anchor.py b/tests/test_market_first_p0_5_time_anchor.py
new file mode 100644
index 0000000..42dd6f0
--- /dev/null
+++ b/tests/test_market_first_p0_5_time_anchor.py
@@ -0,0 +1,154 @@
+# -*- coding: utf-8 -*-
+"""P0-5 集成对抗测试（2026-11-23，judge-p0-integration）：Forward 时间锚。
+
+审计口径：discovered_at 是调用方声称值、不再作为可信入场
+时间锚；以服务器实际入库时间（discovery_events.created_at，
+由 pool.ingest 以服务器时间落字）为唯一可信锚；Forward 入场
+必须严格晚于锚对应的交易日；延迟入库的历史事件强制
+backfill 或拒绝；缺少可信入库时间时拒绝进入 Forward；
+历史行情不得进入有效 Forward 统计。
+"""
+from datetime import date, timedelta
+
+import pytest
+
+from market_first import validation
+from market_first.models import DiscoveryEvent
+from market_first.pool import CandidatePool
+
+
+def _bars(start=date(2026, 9, 1), end=date(2026, 12, 20)):
+    out = []
+    d = start
+    i = 0
+    while d <= end:
+        if d.weekday() < 5:
+            c = 10.0 + 0.01 * i
+            out.append((d.isoformat(), c, c, c, c, 1000.0))
+            i += 1
+        d += timedelta(days=1)
+    return out
+
+
+BARS = _bars()
+
+
+def _pool_with_event(tmp_path, discovered_at, ingested_at,
+                     source_id="inst_lhb_live"):
+    """ingest 后把 discovery_events.created_at 改写为给定的
+    服务器入库时刻（模拟延迟入库：事件声称的发现时间与实际
+    入库时间分离）。ingested_at=None 表示入库时间缺失。"""
+    pool = CandidatePool(db_path=str(tmp_path / "mf.db"))
+    ev = DiscoveryEvent(
+        market="SZ", symbol="002623", name="亚玛顿",
+        source_id=source_id, discovered_at=discovered_at,
+        trigger_condition="inst_net>0", evidence={"inst_net": 100.0})
+    cid, _ = pool.ingest(ev)
+    pool.conn.execute(
+        "UPDATE discovery_events SET created_at=?"
+        " WHERE candidate_id=?", (ingested_at, cid))
+    pool.conn.commit()
+    ev_row = pool.events_for(cid)[0]
+    return pool, cid, ev_row["id"]
+
+
+def test_sept_event_ingested_in_nov_explicit_entry_forced_backfill(tmp_path):
+    """真实对抗：事件声称 2026-09-15 发现、实际 2026-11-20
+    才入库；以 9 月 entry 请求 forward -> 强制 backfill，
+    且不进入 forward_stats。"""
+    pool, cid, ev_id = _pool_with_event(
+        tmp_path, "2026-09-15T16:30:00+08:00",
+        "2026-11-20T09:00:00+08:00")
+    sid = validation.create_sample(
+        pool, cid, "inst_lhb_live", entry_date="2026-09-16",
+        benchmark_price=10.10, kind="forward",
+        discovery_event_id=ev_id, bars=BARS)
+    s = validation.get_sample(pool, sid)
+    assert s["kind"] == "backfill"
+    assert s["entry_date"] == "2026-09-16"
+    assert validation.forward_stats(pool)["total"] == 0
+
+
+def test_sept_event_ingested_in_nov_history_bars_only_rejected(tmp_path):
+    """同一延迟入库事件：只给到 10 月底的历史行情请求
+    forward -> 锚（11-20）之后无 bar，拒绝创建、不落样本，
+    历史行情不得拼出 forward。"""
+    pool, cid, ev_id = _pool_with_event(
+        tmp_path, "2026-09-15T16:30:00+08:00",
+        "2026-11-20T09:00:00+08:00")
+    hist_bars = [b for b in BARS if b[0] <= "2026-10-30"]
+    with pytest.raises(validation.ForwardRejectedError):
+        validation.create_sample(
+            pool, cid, "inst_lhb_live", kind="forward",
+            discovery_event_id=ev_id, bars=hist_bars)
+    n = pool.conn.execute(
+        "SELECT COUNT(*) c FROM validation_samples").fetchone()["c"]
+    assert n == 0
+
+
+def test_sept_event_ingested_in_nov_entry_anchored_at_ingest(tmp_path):
+    """延迟入库事件的 forward 入场只能锚定入库日之后：
+    entry 必须是 2026-11-18（周三，实际入库日）之后第一
+    个交易日 2026-11-19，绝不允许以 9 月行情作 forward
+    入场。（入库日取 11-18 而非更晚：entry 须为已收盘确认
+    的历史交易日，避免与运行当日未收盘 bar 相撞。）"""
+    pool, cid, ev_id = _pool_with_event(
+        tmp_path, "2026-09-15T16:30:00+08:00",
+        "2026-11-18T09:00:00+08:00")
+    sid = validation.create_sample(
+        pool, cid, "inst_lhb_live", kind="forward",
+        discovery_event_id=ev_id, bars=BARS)
+    s = validation.get_sample(pool, sid)
+    assert s["kind"] == "forward"
+    assert s["entry_date"] == "2026-11-19"
+    assert s["benchmark_date"] == "2026-11-19"
+
+
+def test_missing_ingest_time_rejects_forward(tmp_path):
+    """事件行缺服务器入库时间（created_at 为 NULL）：无可信
+    锚 -> 拒绝进入 Forward 并留痕；同事件显式 backfill
+    不受影响。"""
+    pool, cid, ev_id = _pool_with_event(
+        tmp_path, "2026-11-13T16:30:00+08:00", None)
+    with pytest.raises(validation.ForwardRejectedError):
+        validation.create_sample(
+            pool, cid, "inst_lhb_live", kind="forward",
+            discovery_event_id=ev_id, bars=BARS)
+    hist = [h for h in pool.history_for(cid)
+            if "trusted_ingest_time_missing" in (h["reason"] or "")]
+    assert len(hist) == 1
+    sid = validation.create_sample(
+        pool, cid, "inst_lhb_live", entry_date="2026-11-13",
+        benchmark_price=10.05, kind="backfill",
+        discovery_event_id=ev_id, bars=BARS)
+    assert validation.get_sample(pool, sid)["kind"] == "backfill"
+
+
+def test_claimed_discovery_after_ingest_does_not_extend_anchor(tmp_path):
+    """声称发现时间晚于入库时间时，锚仍以入库时间为准
+    （discovered_at 完全不参与锚）：11-13 入库、声称
+    11-16 发现 -> forward 入场为锚后第一个交易日 11-16
+    （周一），而非声称日之后。"""
+    pool, cid, ev_id = _pool_with_event(
+        tmp_path, "2026-11-16T15:58:00+08:00",
+        "2026-11-13T16:30:00+08:00")
+    sid = validation.create_sample(
+        pool, cid, "inst_lhb_live", kind="forward",
+        discovery_event_id=ev_id, bars=BARS)
+    s = validation.get_sample(pool, sid)
+    assert s["kind"] == "forward"
+    assert s["entry_date"] == "2026-11-16"
+
+
+def test_same_day_ingest_positive_control(tmp_path):
+    """正对照：发现当日入库（created_at 与 discovered_at
+    同日）-> forward 入场为次一交易日，与既有口径一致。"""
+    pool, cid, ev_id = _pool_with_event(
+        tmp_path, "2026-11-13T16:30:00+08:00",
+        "2026-11-13T16:35:00+08:00")
+    sid = validation.create_sample(
+        pool, cid, "inst_lhb_live", kind="forward",
+        discovery_event_id=ev_id, bars=BARS)
+    s = validation.get_sample(pool, sid)
+    assert s["kind"] == "forward"
+    assert s["entry_date"] == "2026-11-16"
diff --git a/tests/test_market_first_promotion_handoff.py b/tests/test_market_first_promotion_handoff.py
index 6577314..b98b20f 100644
--- a/tests/test_market_first_promotion_handoff.py
+++ b/tests/test_market_first_promotion_handoff.py
@@ -32,7 +32,10 @@ def _register_test_rule(pool):
     validation.register_rule_implementation("test_rule", _TestRule())
     validation.register_rule(
         pool, "test_rule", _TestRule.version, status="approved",
