+++ b/evidence/fix2/src_after/db.py
@@ -0,0 +1,304 @@
+"""Market-First 独立 SQLite 存储：建表与连接。
+
+新库默认路径为本包目录下的 market_first.db，与生产 sim.db 隔离。
+SCHEMA_SQL 一次建全（含研究/验证/审批/交接模块的表）。
+"""
+from __future__ import annotations
+
+import sqlite3
+from pathlib import Path
+
+DEFAULT_DB_PATH = str(Path(__file__).resolve().parent / "market_first.db")
+
+SCHEMA_SQL = """
+CREATE TABLE IF NOT EXISTS candidates (
+    id INTEGER PRIMARY KEY,
+    market TEXT NOT NULL,
+    symbol TEXT NOT NULL,
+    name TEXT,
+    first_seen_at TEXT,
+    last_seen_at TEXT,
+    research_status TEXT DEFAULT 'pending',
+    validation_status TEXT DEFAULT 'none',
+    promotion_status TEXT DEFAULT 'discovered',
+    risk_status TEXT DEFAULT 'normal',
+    created_at TEXT,
+    updated_at TEXT,
+    UNIQUE(market, symbol)
+);
+
+CREATE TABLE IF NOT EXISTS discovery_events (
+    id INTEGER PRIMARY KEY,
+    candidate_id INTEGER NOT NULL REFERENCES candidates(id),
+    source_id TEXT,
+    market TEXT,
+    symbol TEXT,
+    discovered_at TEXT,
+    trigger_condition TEXT,
+    price_at_discovery REAL,
+    price_data_time TEXT,
+    evidence_json TEXT DEFAULT '{}',
+    created_at TEXT
+);
+
+CREATE TABLE IF NOT EXISTS candidate_history (
+    id INTEGER PRIMARY KEY,
+    candidate_id INTEGER NOT NULL REFERENCES candidates(id),
+    field TEXT,
+    old_value TEXT,
+    new_value TEXT,
+    actor TEXT,
+    reason TEXT,
+    created_at TEXT
+);
+
+CREATE TABLE IF NOT EXISTS research_reports (
+    id INTEGER PRIMARY KEY,
+    candidate_id INTEGER NOT NULL REFERENCES candidates(id),
+    engine_version TEXT,
+    computed_at TEXT,
+    data_asof TEXT,
+    data_version TEXT,
+    factors_json TEXT,
+    total_score REAL,
+    evidence_json TEXT DEFAULT '{}'
+);
+
+CREATE TABLE IF NOT EXISTS validation_samples (
+    id INTEGER PRIMARY KEY,
+    candidate_id INTEGER NOT NULL REFERENCES candidates(id),
+    source_id TEXT,
+    kind TEXT CHECK (kind IN ('forward', 'backfill')),
+    entry_date TEXT,
+    benchmark_price REAL,
+    ret_t5 REAL,
+    ret_t10 REAL,
+    ret_t20 REAL,
+    max_drawdown REAL,
+    maturity_status TEXT DEFAULT 'immature',
+    missing_reason TEXT,
+    evaluated_at TEXT,
+    eval_version TEXT,
+    created_at TEXT,
+    discovery_event_id INTEGER REFERENCES discovery_events(id),
+    bars_asof TEXT,
+    benchmark_date TEXT,
+    benchmark_price_source TEXT,
+    data_version TEXT,
+    benchmark_revision_json TEXT,
+    UNIQUE(candidate_id, source_id, entry_date)
+);
+
+CREATE TABLE IF NOT EXISTS rule_registry (
+    rule_id TEXT NOT NULL,
+    version TEXT NOT NULL,
+    status TEXT NOT NULL DEFAULT 'draft'
+        CHECK (status IN ('draft', 'approved', 'disabled', 'test')),
+    approved_by TEXT,
+    approved_at TEXT,
+    params_json TEXT DEFAULT '{}',
+    created_at TEXT,
+    PRIMARY KEY (rule_id, version)
+);
+
+CREATE TABLE IF NOT EXISTS sample_exclusions (
+    id INTEGER PRIMARY KEY,
+    sample_id INTEGER NOT NULL REFERENCES validation_samples(id),
+    excluded_from TEXT NOT NULL,
+    reason TEXT,
+    decided_by TEXT,
+    created_at TEXT,
+    UNIQUE(sample_id, excluded_from)
+);
+
+CREATE TABLE IF NOT EXISTS validation_decisions (
+    id INTEGER PRIMARY KEY,
+    candidate_id INTEGER NOT NULL REFERENCES candidates(id),
+    rule_version TEXT,
+    sample_scope TEXT,
+    metrics_json TEXT DEFAULT '{}',
+    decision TEXT,
+    basis TEXT,
+    created_at TEXT
+);
+
+CREATE TABLE IF NOT EXISTS fetched_bars (
+    symbol TEXT NOT NULL,
+    date TEXT NOT NULL,
+    open REAL,
+    high REAL,
+    low REAL,
+    close REAL,
+    volume REAL,
+    source TEXT,
+    fetched_at TEXT,
+    PRIMARY KEY (symbol, date, source)
+);
+
+CREATE TABLE IF NOT EXISTS fetched_coverage (
+    symbol TEXT NOT NULL,
+    start TEXT NOT NULL,
+    end TEXT,
+    source TEXT,
+    fetched_at TEXT,
+    PRIMARY KEY (symbol, start, end, source)
+);
+
+CREATE TABLE IF NOT EXISTS approvals (
+    id INTEGER PRIMARY KEY,
+    candidate_id INTEGER NOT NULL REFERENCES candidates(id),
+    decision TEXT CHECK (decision IN ('approved', 'rejected')),
+    approver TEXT,
+    decided_at TEXT,
+    basis TEXT,
+    versions_json TEXT DEFAULT '{}'
+);
+
+CREATE TABLE IF NOT EXISTS handoffs (
+    id INTEGER PRIMARY KEY,
+    candidate_id INTEGER NOT NULL REFERENCES candidates(id),
+    approval_id INTEGER REFERENCES approvals(id),
+    payload_json TEXT,
+    status TEXT DEFAULT 'simulated',
+    created_at TEXT
+);
+"""
+
+
+def _resolve(db_path: str | None) -> str:
+    return str(db_path) if db_path is not None else DEFAULT_DB_PATH
+
+
+def connect(db_path: str | None = None) -> sqlite3.Connection:
+    """打开连接：row_factory=sqlite3.Row、外键开启。"""
+    path = _resolve(db_path)
+    if path != ":memory:":
+        Path(path).parent.mkdir(parents=True, exist_ok=True)
+    conn = sqlite3.connect(path)
+    conn.row_factory = sqlite3.Row
+    conn.execute("PRAGMA foreign_keys=ON")
+    return conn
+
+
+# 第一轮审计修复（fix1）新增列：旧库靠 ALTER 幂等补齐，新库由
+# SCHEMA_SQL 直接建全。ALTER 只加可空列，不改动既有行数据。
+_FIX1_SAMPLE_COLUMNS = {
+    "discovery_event_id": "INTEGER",
+    "bars_asof": "TEXT",
+    "benchmark_date": "TEXT",
+    "benchmark_price_source": "TEXT",
+    "data_version": "TEXT",
+}
+
+_FIX1_TABLES_SQL = """
+CREATE TABLE IF NOT EXISTS sample_exclusions (
+    id INTEGER PRIMARY KEY,
+    sample_id INTEGER NOT NULL REFERENCES validation_samples(id),
+    excluded_from TEXT NOT NULL,
+    reason TEXT,
+    decided_by TEXT,
+    created_at TEXT,
+    UNIQUE(sample_id, excluded_from)
+);
+
+CREATE TABLE IF NOT EXISTS validation_decisions (
+    id INTEGER PRIMARY KEY,
+    candidate_id INTEGER NOT NULL REFERENCES candidates(id),
+    rule_version TEXT,
+    sample_scope TEXT,
+    metrics_json TEXT DEFAULT '{}',
+    decision TEXT,
+    basis TEXT,
+    created_at TEXT
+);
+
+CREATE TABLE IF NOT EXISTS fetched_bars (
+    symbol TEXT NOT NULL,
+    date TEXT NOT NULL,
+    open REAL,
+    high REAL,
+    low REAL,
+    close REAL,
+    volume REAL,
+    source TEXT,
+    fetched_at TEXT,
+    PRIMARY KEY (symbol, date, source)
+);
+
+CREATE TABLE IF NOT EXISTS fetched_coverage (
+    symbol TEXT NOT NULL,
+    start TEXT NOT NULL,
+    end TEXT,
+    source TEXT,
+    fetched_at TEXT,
+    PRIMARY KEY (symbol, start, end, source)
+);
+"""
+
+
+def ensure_fix1_schema(conn) -> None:
+    """幂等补齐 fix1 结构：validation_samples 新列 + 三张新表。
+
+    对既有行只新增 NULL 列，绝不 UPDATE/DELETE 既有数据。
+    """
+    cols = {r[1] for r in conn.execute(
+        "PRAGMA table_info(validation_samples)")}
+    if cols:
+        for name, typ in _FIX1_SAMPLE_COLUMNS.items():
+            if name not in cols:
+                conn.execute(
+                    "ALTER TABLE validation_samples ADD COLUMN %s %s"
+                    % (name, typ))
+    conn.executescript(_FIX1_TABLES_SQL)
+    conn.commit()
+
+
+# 独立验收前补正（fix2）新增结构：validation_samples 的
+# benchmark 修订记录列 + rule_registry 规则注册表。同样只加
+# 可空列/新表，绝不 UPDATE/DELETE 既有数据。
+_FIX2_SAMPLE_COLUMNS = {
+    "benchmark_revision_json": "TEXT",
+}
+
+_FIX2_TABLES_SQL = """
+CREATE TABLE IF NOT EXISTS rule_registry (
+    rule_id TEXT NOT NULL,
+    version TEXT NOT NULL,
+    status TEXT NOT NULL DEFAULT 'draft'
+        CHECK (status IN ('draft', 'approved', 'disabled', 'test')),
+    approved_by TEXT,
+    approved_at TEXT,
+    params_json TEXT DEFAULT '{}',
+    created_at TEXT,
+    PRIMARY KEY (rule_id, version)
+);
+"""
+
+
+def ensure_fix2_schema(conn) -> None:
+    """幂等补齐 fix2 结构：benchmark_revision_json 列 +
+    rule_registry 表。对既有行只新增 NULL 列。"""
+    cols = {r[1] for r in conn.execute(
+        "PRAGMA table_info(validation_samples)")}
+    if cols:
+        for name, typ in _FIX2_SAMPLE_COLUMNS.items():
+            if name not in cols:
+                conn.execute(
+                    "ALTER TABLE validation_samples ADD COLUMN %s %s"
+                    % (name, typ))
+    conn.executescript(_FIX2_TABLES_SQL)
+    conn.commit()
+
+
+def init_db(db_path: str | None = None) -> str:
+    """建表（幂等）并返回实际库路径。"""
+    path = _resolve(db_path)
+    conn = connect(path)
+    try:
+        conn.executescript(SCHEMA_SQL)
+        conn.commit()
+        ensure_fix1_schema(conn)
+        ensure_fix2_schema(conn)
+    finally:
+        conn.close()
+    return path
diff --git a/evidence/fix2/src_after/promotion.py b/evidence/fix2/src_after/promotion.py
new file mode 100644
index 0000000..399747f
--- /dev/null
+++ b/evidence/fix2/src_after/promotion.py
@@ -0,0 +1,206 @@
+"""Promotion & Approval：晋升状态机与人工审批。
+
+状态机由显式转移表 TRANSITIONS 强制流转，任何表外转移都会
+先在 candidate_history 留痕（field='promotion_transition_attempt'）
+再抛 IllegalTransitionError，绝不静默放行。
+
+验证通过 != 自动批准：进入 approved 的唯一入口是 decide()
+（人工审批，approver/basis/versions 全量留痕于 approvals 表）。
+"""
+from __future__ import annotations
+
+import json
+from datetime import datetime
+
+# 全部状态（顺序即生命周期顺序）
+STATES = (
+    "discovered",
+    "pending_research",
+    "researching",
+    "validating",
+    "validation_passed",
+    "validation_failed",
+    "pending_approval",
+    "approved",
+    "rejected",
+)
+
+# 显式转移表：当前状态 -> 允许的下一状态集合（终态为空集）
+TRANSITIONS = {
+    "discovered": frozenset({"pending_research"}),
+    "pending_research": frozenset({"researching"}),
+    "researching": frozenset({"validating"}),
+    "validating": frozenset({"validation_passed", "validation_failed"}),
+    "validation_failed": frozenset({"pending_research"}),
+    "validation_passed": frozenset({"pending_approval"}),
+    "pending_approval": frozenset({"approved", "rejected"}),
+    "approved": frozenset(),
+    "rejected": frozenset(),
+}
+
+DEFAULT_VERSIONS = {"promotion_engine": "mf-promo-1.0"}
+
+
+class IllegalTransitionError(Exception):
+    """非法状态转移（已在 candidate_history 留痕后抛出）。"""
+
+
+def _now_iso() -> str:
+    return datetime.now().astimezone().isoformat(timespec="seconds")
+
+
+def _reject(pool, cid, current, to_state, actor, detail):
+    """非法转移统一路径：先留痕，再抛错。"""
+    reason = "ILLEGAL TRANSITION REJECTED: %s" % detail
+    pool.record_history(
+        cid,
+        field="promotion_transition_attempt",
+        old=current,
+        new=to_state,
+        actor=actor,
+        reason=reason,
+    )
+    raise IllegalTransitionError(reason)
+
+
+# 审批终态：转移表上 pending_approval 可达，但只能经 decide()
+# 人工审批进入；公开 transition() 直达一律按非法转移处理。
+DECISION_STATES = frozenset({"approved", "rejected"})
+
+# 验证通过态：转移表上 validating 可达，但只能由验证引擎的
+# judge_validation 按版本化规则判定产生；公开 transition() 直达
+# 一律按非法转移处理（第一轮审计修复 P0-3）。
+VALIDATION_GATE_STATES = frozenset({"validation_passed"})
+
+
+def _apply_transition(pool, cid, current, to_state, actor, reason=""):
+    """表内流转的实际执行（调用方已完成合法性判定）。"""
+    pool.set_fields(
+        cid,
+        actor=actor,
+        reason=reason if reason else None,
+        promotion_status=to_state,
+    )
+    return to_state
+
+
+def transition(pool, cid, to_state, actor, reason=""):
+    """按转移表流转 promotion_status。
+
+    合法：经 pool.set_fields 写字段（逐字段记 history）。
+    非法：先 record_history 留痕，再抛 IllegalTransitionError。
+    approved / rejected 虽在转移表中（pending_approval 可达），
+    但只能经 decide() 进入，transition() 直达按非法处理——
+    验证通过 != 自动批准，除 decide 外没有任何函数能进入 approved。
+    返回流转后的状态字符串。
+    """
+    cand = pool.get_by_id(cid)
+    if cand is None:
+        raise ValueError("候选不存在：id=%s" % (cid,))
+    current = cand.get("promotion_status")
+    if to_state in DECISION_STATES:
+        _reject(
+            pool, cid, current, to_state, actor,
+            "%s -> %s 属人工审批终态，只能经 decide() 审批进入，"
+            "transition() 直达被拒" % (current, to_state),
+        )
+    if to_state in VALIDATION_GATE_STATES:
+        _reject(
+            pool, cid, current, to_state, actor,
+            "%s -> %s 属验证引擎判定态，只能由 "
+            "validation.judge_validation 按版本化规则产生，"
+            "transition() 直达被拒" % (current, to_state),
+        )
+    allowed = TRANSITIONS.get(current, frozenset())
+    if to_state not in allowed:
+        _reject(
+            pool, cid, current, to_state, actor,
+            "%s -> %s 不在允许转移内（当前状态允许：%s）"
+            % (current, to_state,
+               ",".join(sorted(allowed)) if allowed else "无，终态"),
+        )
+    return _apply_transition(pool, cid, current, to_state, actor, reason)
+
+
+def _apply_validation_passed(pool, cid, actor, reason="",
+                             decision_id=None):
+    """内部受控入口：validating -> validation_passed。
+
+    唯一合法调用方是 validation.judge_validation 在判定
+    decision='passed' 后调用（fix2-3 加固）：必须携带
+    decision_id，且库内须存在该 id、属于该候选、decision=
+    'passed' 的 validation_decisions 记录；核验不过先在
+    candidate_history 留痕再抛 IllegalTransitionError——任何
+    模块绕过 judge 直接调用本函数都无法完成流转。当前状态
+    不是 validating 时同样拒绝。不经公开 transition()（其对
+    validation_passed 直达一律拒绝）。
+    """
+    cand = pool.get_by_id(cid)
+    if cand is None:
+        raise ValueError("候选不存在：id=%s" % (cid,))
+    current = cand.get("promotion_status")
+    verified = False
+    if decision_id is not None:
+        row = pool.conn.execute(
+            "SELECT candidate_id, decision FROM validation_decisions"
+            " WHERE id = ?", (decision_id,)).fetchone()
+        verified = (row is not None
+                    and row["candidate_id"] == cid
+                    and row["decision"] == "passed")
+    if not verified:
+        _reject(
+            pool, cid, current, "validation_passed", actor,
+            "受控流转核验失败：decision_id=%s 无对应的 "
+            "validation_decisions passed 记录，绕过 "
+            "judge_validation 的直接调用被拒" % (decision_id,))
+    if current != "validating":
+        raise IllegalTransitionError(
+            "validation_passed 只能从 validating 经 judge_validation "
+            "判定流转，当前状态为 %s" % (current,))
+    return _apply_transition(pool, cid, current, "validation_passed",
+                             actor, reason)
+
+
+def decide(pool, cid, approver, decision, basis="", versions=None):
+    """人工审批：唯一能进入 approved / rejected 终态的入口。
+
+    decision 只接受 'approved' / 'rejected'；当前状态必须为
+    pending_approval，否则走非法路径（留痕 + IllegalTransitionError）。
+    同一事务内写 approvals 一行并流转到对应终态，返回 approval_id。
+    """
+    if decision not in ("approved", "rejected"):
+        raise ValueError(
+            "decision 只接受 'approved' / 'rejected'，收到：%r" % (decision,))
+    cand = pool.get_by_id(cid)
+    if cand is None:
+        raise ValueError("候选不存在：id=%s" % (cid,))
+    current = cand.get("promotion_status")
+    if current != "pending_approval":
+        _reject(
+            pool, cid, current, decision, approver,
+            "decide(decision=%s) 要求当前状态为 pending_approval，"
+            "实际为 %s" % (decision, current),
+        )
+    versions_payload = versions if versions is not None else dict(DEFAULT_VERSIONS)
+    conn = pool.conn
+    try:
+        cur = conn.execute(
+            "INSERT INTO approvals (candidate_id, decision, approver,"
+            " decided_at, basis, versions_json) VALUES (?, ?, ?, ?, ?, ?)",
+            (cid, decision, approver, _now_iso(), basis,
+             json.dumps(versions_payload, ensure_ascii=False)),
+        )
+        approval_id = cur.lastrowid
+        # 不单独 commit：与随后的状态流转同事务提交
+        # （pool.set_fields 内部 commit 一并落盘两处写入）。
+        # 审批终态只能经本函数进入，故此处走内部 _apply_transition，
+        # 不经公开 transition()（其对 approved/rejected 直达一律拒绝）。
+        _apply_transition(
+            pool, cid, current, decision, actor=approver,
+            reason="人工审批 decide=%s approver=%s approval_id=%s"
+                   % (decision, approver, approval_id),
+        )
+    except Exception:
+        conn.rollback()
+        raise
+    return approval_id
