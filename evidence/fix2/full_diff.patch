+        if rule is None:
+            decision = "not_evaluable"
+            rule_version = NO_RULE
+            basis = ("no_approved_rule: 验证数值门槛尚未经用户确认，"
+                     "规则注册表为空；系统只能记录验证结果，"
+                     "不得产生 validation_passed")
