[Unit]
Description=Paper sim 8502 (writable local instance)
After=network.target

[Service]
WorkingDirectory=/home/hatch/workspace/paper-trading-sim
ExecStart=/home/hatch/workspace/paper-trading-sim/.venv/bin/streamlit run app.py --server.port 8502 --server.address 127.0.0.1 --server.headless true --browser.gatherUsageStats false
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
