+++    pool, cid, sid, bars = _forward_sample(tmp_path)
+++    out = validation.evaluate_sample(pool, sid, bars)
+++    assert out["maturity_status"] == "not_evaluable"
+++    assert "no fetched_bars" in out["missing_reason"]
