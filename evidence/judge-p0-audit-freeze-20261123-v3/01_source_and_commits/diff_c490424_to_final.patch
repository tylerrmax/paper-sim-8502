++def _gen_bars(start=date(2026, 11, 13), days=40, step=0.1):
++    out = []
++    d = start
++    i = 0
++    while d <= start + timedelta(days=days):
++        if d.weekday() < 5:
++            c = 10.0 + step * i
++            out.append((d.isoformat(), c, c, c, c, 1000.0))
++            i += 1
++        d += timedelta(days=1)
++    return out
++
