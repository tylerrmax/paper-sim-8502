+++
+++def _walk_to_validating(tmp_path, symbol="603893"):
+++    pool = CandidatePool(db_path=str(tmp_path / "mf.db"))
+++    ev = DiscoveryEvent(
+++        market="SH", symbol=symbol, name="测试标的",
